{
  "name": "archtrace",
  "version": "0.1.0",
  "description": "Check that code and deployment configs match a LikeC4 architecture model. Includes Claude Code skills to draft the model from docs and resolve drift.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AdityaNerpagar/Archtrace.git"
  },
  "homepage": "https://github.com/AdityaNerpagar/Archtrace#readme",
  "bugs": {
    "url": "https://github.com/AdityaNerpagar/Archtrace/issues"
  },
  "author": "Aditya Nerpagar",
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('dist/cli.js',0o755)\"",
    "check": "node dist/cli.js check",
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "license": "MIT",
  "dependencies": {
    "dependency-cruiser": "16.10.4",
    "likec4": "1.59.4",
    "typescript": "5.9.3",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15"
  },
  "type": "module",
  "bin": {
    "archtrace": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "architecture",
    "likec4",
    "c4-model",
    "architecture-as-code",
    "dependency-check",
    "drift",
    "claude-code",
    "agent-skills",
    "emerge"
  ],
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ]
}
